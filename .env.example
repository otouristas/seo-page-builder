# Local development only. Use a separate Supabase project and provider test keys.
# Production: https://ranksushi.com. Preview defaults to VERCEL_URL if this is unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret/service role key: SERVER ONLY, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Generate independent 32-byte values: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
RATE_LIMIT_SALT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=
PAGESPEED_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
PERPLEXITY_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Set to 1 ONLY when running the isolated local Inngest dev server.
INNGEST_DEV=0

# Use a restricted test key for development; configure minimum needed permissions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_MAKI=
STRIPE_PRICE_NIGIRI=
STRIPE_PRICE_OMAKASE=
STRIPE_PORTAL_CONFIGURATION=
# Live Checkout stays disabled until ALL three explicit launch gates are true.
BILLING_LIVE_ENABLED=false
BILLING_COSTS_APPROVED=false
BILLING_MERCHANT_READY=false
# Enable only after verifying active registrations, origin address and product tax setup.
STRIPE_AUTOMATIC_TAX=false

RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
# Authentication mail is sent by Supabase Auth via configured Resend SMTP.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
