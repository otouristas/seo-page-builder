# --- Auth (Better Auth). Leave VITE_AUTH_ENABLED unset to run in guest-only mode. ---
VITE_AUTH_ENABLED=true
BETTER_AUTH_SECRET=change-me-32-chars-minimum
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Database. Unset => embedded PGLite in ./.data/pglite (dev/preview). ---
DATABASE_URL=

# --- DataForSEO live SERP (8 lookups / user / day). Unset => modeled SERP only. ---
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
