{
  "name": "ranksushi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:setup": "node scripts/check-setup.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "verify:providers": "node scripts/verify-providers.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json",
    "check": "npm run typecheck && npm run lint && npm test",
    "check:seo-launch": "node scripts/check-seo-launch.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@sentry/nextjs": "10.73.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "cheerio": "1.2.0",
    "clsx": "2.1.1",
    "inngest": "4.20.0",
    "ipaddr.js": "2.5.0",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "openai": "7.10.0",
    "pdf-lib": "1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.26.0",
    "robots-parser": "3.0.1",
    "stripe": "22.6.1",
    "tailwind-merge": "3.6.0",
